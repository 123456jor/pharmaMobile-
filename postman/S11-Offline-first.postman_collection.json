{
  "info": {
    "name": "S11 Offline-first - Verificacion real",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "nombreOffline",
      "value": "A_Offline_S11_1531"
    },
    {
      "key": "productoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Login admin - obtener JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"Admin123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:8080/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set('jwt',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Listar - comprobar producto sincronizado",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "http://localhost:8080/api/v1/productos?tamanio=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const datos=pm.response.json().contenido;",
              "const encontrados=datos.filter(p=>p.nombre===pm.collectionVariables.get('nombreOffline'));",
              "pm.test('Producto offline existe una sola vez',()=>pm.expect(encontrados.length).to.eql(1));",
              "pm.test('ID real positivo',()=>pm.expect(encontrados[0].id).to.be.above(0));",
              "if(encontrados.length===1) pm.collectionVariables.set('productoId',encontrados[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Buscar - ID real positivo",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "http://localhost:8080/api/v1/productos/{{productoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Nombre coincide',()=>pm.expect(pm.response.json().nombre).to.eql(pm.collectionVariables.get('nombreOffline')));",
              "pm.test('ID positivo',()=>pm.expect(pm.response.json().id).to.be.above(0));"
            ]
          }
        }
      ]
    }
  ]
}