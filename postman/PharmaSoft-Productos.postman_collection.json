{
  "info": {
    "_postman_id": "b1e11130-7928-48f0-9d40-11494d652241",
    "name": "PharmaSoft - Productos CRUD",
    "description": "Pruebas completas de la Sesión 10: autenticación JWT, autorización por permisos y CRUD autenticado. Base URL local: http://localhost:8080. Las credenciales incluidas son usuarios de demostración del backend académico.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "productoId", "value": "1", "type": "string" },
    { "key": "categoriaId", "value": "1", "type": "string" },
    { "key": "username", "value": "admin", "type": "string" },
    { "key": "password", "value": "Admin123", "type": "string" }
  ],
  "item": [
    {
      "name": "00 - Estado del servidor",
      "item": [
        {
          "name": "Verificar API (health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        }
      ]
    },
    {
      "name": "01 - Autenticación JWT",
      "description": "Inicia sesión con el usuario configurado en las variables username/password y guarda el JWT automáticamente.",
      "item": [
        {
          "name": "Iniciar sesión y guardar JWT",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar usuario actual",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "02 - Productos (CRUD)",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/productos?pagina=0&tamanio=20&ordenarPor=id&direccion=asc", "host": ["{{baseUrl}}"], "path": ["api", "v1", "productos"], "query": [{ "key": "pagina", "value": "0" }, { "key": "tamanio", "value": "20" }, { "key": "ordenarPor", "value": "id" }, { "key": "direccion", "value": "asc" }] }
          }
        },
        {
          "name": "Buscar producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/productos/{{productoId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "productos", "{{productoId}}"] }
          }
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto prueba Postman\",\n  \"precio\": 12.50,\n  \"stock\": 25,\n  \"estado\": true,\n  \"categoriaId\": {{categoriaId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/productos", "host": ["{{baseUrl}}"], "path": ["api", "v1", "productos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id !== undefined) pm.collectionVariables.set('productoId', String(data.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar producto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto prueba Postman editado\",\n  \"precio\": 13.75,\n  \"stock\": 30,\n  \"estado\": true,\n  \"categoriaId\": {{categoriaId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/productos/{{productoId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "productos", "{{productoId}}"] }
          }
        },
        {
          "name": "Eliminar producto (baja lógica)",
          "request": {
            "method": "DELETE",
            "header": [],
            "description": "El backend devuelve 204 y marca estado=false; el registro no se borra físicamente.",
            "url": { "raw": "{{baseUrl}}/api/v1/productos/{{productoId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "productos", "{{productoId}}"] }
          }
        }
      ]
    },
    {
      "name": "03 - Categorías (consulta)",
      "item": [
        {
          "name": "Listar categorías (buscar categoriaId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/categorias", "host": ["{{baseUrl}}"], "path": ["api", "v1", "categorias"] }
          }
        }
      ]
    },
    {
      "name": "04 - Autorización 401 y 403",
      "description": "Ejecutar en este orden para documentar la protección del backend.",
      "item": [
        {
          "name": "Productos sin JWT - espera 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/productos", "host": ["{{baseUrl}}"], "path": ["api", "v1", "productos"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Sin token devuelve 401', () => pm.response.to.have.status(401));"] }
          }]
        },
        {
          "name": "Login almacen y guardar JWT",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"almacen\",\n  \"password\": \"Almacen123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Login almacen devuelve 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "if (data.token) pm.collectionVariables.set('token', data.token);"
            ] }
          }]
        },
        {
          "name": "Clientes con almacen - espera 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/clientes", "host": ["{{baseUrl}}"], "path": ["api", "v1", "clientes"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Almacen no puede consultar clientes: 403', () => pm.response.to.have.status(403));"] }
          }]
        }
      ]
    }
  ]
}
