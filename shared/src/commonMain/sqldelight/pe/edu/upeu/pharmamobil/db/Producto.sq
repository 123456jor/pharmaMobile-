CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    estado INTEGER NOT NULL DEFAULT 1,
    categoriaId INTEGER NOT NULL DEFAULT 0,
    categoriaNombre TEXT,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

listarTodos:
SELECT * FROM producto ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE pendiente = 1;

insertar:
INSERT OR REPLACE INTO producto VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM producto;

borrarPorId:
DELETE FROM producto WHERE id = ?;

pendientesPorEnviar:
SELECT * FROM producto WHERE pendiente = 1 AND intentos < :maxIntentos ORDER BY id;

contarPendientes:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos < :maxIntentos;

contarFallidas:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos >= :maxIntentos;

porId:
SELECT * FROM producto WHERE id = ?;

sumarIntento:
UPDATE producto SET intentos = intentos + 1, ultimoError = :ultimoError
WHERE id = :id AND pendiente = 1 AND intentos < :maxIntentos;

marcarFallida:
UPDATE producto SET intentos = :maxIntentos, ultimoError = :motivo
WHERE id = :id AND pendiente = 1;

corregirPendiente:
UPDATE producto SET nombre = :nombre, precio = :precio, stock = :stock,
    categoriaId = :categoriaId, intentos = 0, ultimoError = NULL
WHERE id = :id AND pendiente = 1;

reiniciarIntentos:
UPDATE producto SET intentos = 0, ultimoError = NULL WHERE id = :id AND pendiente = 1;
