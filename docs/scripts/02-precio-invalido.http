@baseUrl = http://localhost:8080/api/v1
@categoriaExistenteId = {{CATEGORIA_EXISTENTE}}

### Precio cero (esperado por la ficha: 400)
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "Producto de prueba",
  "precio": 0,
  "stock": 1,
  "estado": true,
  "categoriaId": {{categoriaExistenteId}}
}

### Precio negativo (esperado por la ficha: 400)
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "Producto de prueba",
  "precio": -1,
  "stock": 1,
  "estado": true,
  "categoriaId": {{categoriaExistenteId}}
}
